# Cloudflare Pages security + caching headers (Next copies public/* into out/).
# Cloudflare Pages honors this file; GitHub Pages (the fallback host) ignores it
# and cannot set custom headers, so the strong headers below apply on the primary
# Cloudflare deployment. 'unsafe-inline' is required because Next's static export
# inlines its hydration bootstrap script and Recharts injects inline styles. If
# you configure a subscribe endpoint, add its origin to connect-src below.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), browsing-topics=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; form-action 'self' mailto:; frame-ancestors 'none'; manifest-src 'self'; upgrade-insecure-requests

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/icon.svg
  Cache-Control: public, max-age=86400
